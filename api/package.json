{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --env-file ../.env",
    "start": "node --env-file=../.env dist/main",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "nest build && node --env-file=../.env dist/db/seed/seed.js",
    "db:schema": "(echo \"-- Gym Tracker: PostgreSQL schema. Generated from api/src/db/schema.ts by pnpm db:schema, do not edit.\"; drizzle-kit export) > ../docs/schema.sql"
  },
  "dependencies": {
    "@gym/shared": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "argon2": "^0.45.2",
    "drizzle-orm": "1.0.0-rc.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "^6.0.2"
  }
}
