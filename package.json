{
  "name": "gym-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter shared build",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter shared build && pnpm -r typecheck",
    "lint": "oxlint",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:schema": "pnpm --filter api db:schema"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.15"
  },
  "devDependencies": {
    "oxlint": "^1.93.0",
    "playwright-core": "^1.65.1"
  }
}
